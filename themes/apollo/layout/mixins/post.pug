mixin postInfo(item)
    .post-info
        time(datetime=date_xml(item.date))= full_date(item.date, 'll')
        if is_post() && item.updated && date(item.updated, 'YYYY-MM-DD') > date(item.date, 'YYYY-MM-DD')
            span.post-updated
                = __('updated') + ' '
                time(datetime=date_xml(item.updated))= full_date(item.updated, 'll')
        if item.from && (is_home() || is_post())
            a.post-from(href=item.from target="_blank" rel="noopener noreferrer" title=item.from)!= __('translated')


//- Index Page
mixin posts()
    ul.home.post-list
        - page.posts.each(function (item) {
            li.post-list-item
                article.post-block
                    h2.post-title
                        a.post-title-link(href= url_for(item.path))
                            != item.title
                    +postInfo(item)
                    .post-content
                        if item.summary
                            p= truncate(item.summary, { length: 140 })
                        else
                            - var summary = strip_html(item.excerpt || item.content).replace(/&(?:emsp|ensp|nbsp);/g, ' ').replace(/\s+/g, ' ').trim()
                            p!= truncate(summary, { length: 140 })
                    a.read-more(href= url_for(item.path) aria-label=__('more') + ': ' + item.title)!= __('more')
        - })

//- Archive Page
mixin postList()
    .archive.archive-index
        - var year = 0;
        - var change = false;
        - page.posts.each(function (item) {
            - var itemYear = date(item.date, 'YYYY') - 0;
            - change = year !== itemYear;
            - year = change ? itemYear : year;
            if change 
                h2.archive-year!= year
            article.post-item
                time.post-info(datetime=date(item.date, 'YYYY-MM-DD'))!= full_date(item.date, 'll')
                a.post-title-link(href= url_for(item.path))
                    != item.title
        - })

//- Post Page
mixin post(item)
    - var isArticlePost = typeof is_post === 'function' && is_post()
    - var hasToc = isArticlePost && item.content && /<h[23][^>]*id=/.test(item.content)
    - var tocHtml = hasToc ? toc(item.content, { list_number: false, min_depth: 2, max_depth: 3 }) : ''
    .post(class=[isArticlePost ? 'post-detail' : 'page-detail', hasToc ? 'has-toc' : ''].join(' '))
        .post-reading
            article.post-block
                h1.post-title
                    != item.title
                if isArticlePost
                    +postInfo(item)
                if hasToc
                    details.post-toc-disclosure
                        summary= '目录'
                        .post-toc-content
                            != tocHtml
                .post-content
                    != item.content
            if hasToc
                aside.post-toc-rail(aria-label='文章目录')
                    nav.post-toc-nav(aria-label='文章目录')
                        p.post-toc-title= '目录'
                        != tocHtml

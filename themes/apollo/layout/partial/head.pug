meta(charset="utf-8")
meta(name="X-UA-Compatible", content="IE=edge")

- var pageTitle = page.title || ''
- if (is_tag()) pageTitle = page.tag + ' 标签'
- else if (is_category()) pageTitle = page.category + ' 分类'
- else if (is_archive()) pageTitle = (page.year ? page.year + (page.month ? ' / ' + page.month : '') + ' · ' : '') + '归档'
- if (page.current > 1) pageTitle = (pageTitle ? pageTitle + ' · ' : '') + '第 ' + page.current + ' 页'
title= (pageTitle ? pageTitle + ' · ' : '') + config.title
- var description = seo_description()
meta(name="description", content=description)
- var canonical = full_url_for(path.replace(/(^|\/)index\.html$/, '$1'))
link(rel="canonical", href=canonical)
if is_post()
    script(type="application/ld+json")!= article_json_ld(canonical, description)

meta(name="viewport", content="width=device-width, initial-scale=1")
link(rel="icon", href=url_for(theme.favicon))
link(rel="stylesheet", href=url_for("css/apollo.css"))

- var xml = config.url + '/atom.xml'
    link(rel="search", type="application/opensearchdescription+xml", href=xml, title=config.title)
    

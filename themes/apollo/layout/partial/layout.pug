doctype
html(lang=config.language)
    - var siteTitle = config.title || config.author || 'ILOFT'
    - var pagePath = page.path || ''
    - var surfaceClasses = []
    - if (is_home()) surfaceClasses.push('surface-home')
    - else if (is_archive()) surfaceClasses.push('surface-archive')
    - else if (is_post()) surfaceClasses.push('surface-post')
    - else surfaceClasses.push('surface-page')
    - if (pagePath.indexOf('about/') === 0) surfaceClasses.push('surface-about')
    - if (pagePath.indexOf('links/') === 0) surfaceClasses.push('surface-links')
    head
        include head
    body(class=surfaceClasses.join(' '))
        .wrap
            header
                a.logo-link(href=url_for())
                    img(src=url_for(theme.logo) alt=siteTitle + ' home')
                include nav
            main.container(class=surfaceClasses.join(' '))
                block container
            footer
                block pagination
                block copyright
        include scripts

ul.nav.nav-list
    each value, key in theme.menu
        li.nav-list-item
            - var re = /^https?:\/\//i;
            - var isExternal = re.test(value)
            - var tar = isExternal ? "_blank" : "_self"
            - var rel = isExternal ? "noopener noreferrer" : false
            - var act = !isExternal && "/"+page.current_url === value
            a.nav-list-link(class={active: act} href=url_for(value) target=tar rel=rel)
                != key.toUpperCase()
